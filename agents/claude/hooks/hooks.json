{
  "hooks": {
    "PreToolUse": [
      {"matcher":"Write|Edit|NotebookEdit","hooks":[{"type":"command","command":"golaw","args":["hook","claude"],"timeout":10,"onFailure":"block"}]},
      {"matcher":"Read","hooks":[{"type":"command","command":"golaw","args":["hook","claude"],"timeout":10,"onFailure":"block"}]},
      {"matcher":"Bash|PowerShell","hooks":[{"type":"command","command":"golaw","args":["hook","claude"],"timeout":10,"onFailure":"block"}]}
    ],
    "PostToolUse": [
      {"matcher":"Write|Edit|NotebookEdit","hooks":[{"type":"command","command":"golaw","args":["hook","claude"],"timeout":10,"onFailure":"block"}]},
      {"matcher":"Bash|PowerShell","hooks":[{"type":"command","command":"golaw","args":["hook","claude"],"timeout":10,"onFailure":"block"}]}
    ],
    "PostToolUseFailure": [
      {"matcher":"Bash|PowerShell","hooks":[{"type":"command","command":"golaw","args":["hook","claude"],"timeout":10,"onFailure":"block"}]}
    ]
  }
}
