module {{.ModulePath}}/tools

go {{.ToolsGo}}

tool (
	github.com/evilmartians/lefthook/v2
	github.com/golangci/golangci-lint/v2/cmd/golangci-lint
{{- if has .Capabilities "hexagonal"}}
	github.com/jmattheis/goverter/cmd/goverter
{{- end}}
{{- if has .Capabilities "api"}}
	github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen
{{- end}}
{{- if has .Capabilities "db"}}
	github.com/sqlc-dev/sqlc/cmd/sqlc
{{- end}}
	github.com/zricethezav/gitleaks/v8
	golang.org/x/vuln/cmd/govulncheck
)

require (
	github.com/evilmartians/lefthook/v2 v{{.Tools.lefthook}}
	github.com/golangci/golangci-lint/v2 v{{index .Tools "golangci-lint"}}
{{- if has .Capabilities "hexagonal"}}
	github.com/jmattheis/goverter v{{.Tools.goverter}}
{{- end}}
{{- if has .Capabilities "api"}}
	github.com/oapi-codegen/oapi-codegen/v2 v{{index .Tools "oapi-codegen"}}
{{- end}}
{{- if has .Capabilities "db"}}
	github.com/sqlc-dev/sqlc v{{.Tools.sqlc}}
{{- end}}
	github.com/zricethezav/gitleaks/v8 v{{.Tools.gitleaks}}
	golang.org/x/vuln v{{.Tools.govulncheck}}
)
