package {{.Package}}_test

func TestFakeKeepsTheContractOf{{.Port}}(t *testing.T) {
	t.Parallel()
	{{.Package}}.Run(t, func(t *testing.T) {{.Package}}.Subject {
		t.Helper()
		fake := {{.Package}}.NewFake()
		return {{.Package}}.Subject{Port: fake, Seed: func(t *testing.T, c {{.Package}}.Case) {
			t.Helper()
			fake.Program(c.Method, append(slices.Clone(c.Want), c.WantErr)...)
		}}
	})
}
