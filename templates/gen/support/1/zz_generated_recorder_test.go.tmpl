package {{.Package}}_test

import (
	"errors"
	"testing"

	"{{.Import}}"
)

const (
	method = "ReadPlan"
	plan   = "plan"
)

func TestRecorderAnswersWhatItWasProgrammedAndKeepsTheCalls(t *testing.T) {
	t.Parallel()
	rec := {{.Package}}.NewRecorder()
	if got := rec.Answer(method, t.Context()); got != nil {
		t.Errorf("an unprogrammed answer = %v, want nil", got)
	}
	rec.Program(method, plan, {{.Package}}.ErrPortMissing)
	answer := rec.Answer(method, plan)
	if got := {{.Package}}.Result[string](answer, 0); got != plan {
		t.Errorf("Result[string] = %q, want %q", got, plan)
	}
	if err := {{.Package}}.Result[error](answer, 1); !errors.Is(err, {{.Package}}.ErrPortMissing) {
		t.Errorf("Result[error] = %v", err)
	}
	calls := rec.Calls(method)
	if len(calls) != 2 || len(calls[0]) != 1 || len(calls[1]) != 1 || calls[1][0] != plan {
		t.Errorf("Calls = %v, want both calls in order", calls)
	}
}

func TestResultAnswersTheZeroValueWhenAbsent(t *testing.T) {
	t.Parallel()
	answer := []any{plan}
	for name, got := range map[string]string{
		"out of range":   {{.Package}}.Result[string](answer, 1),
		"a negative one": {{.Package}}.Result[string](answer, -1),
	} {
		if got != "" {
			t.Errorf("%s = %q, want the zero value", name, got)
		}
	}
	if got := {{.Package}}.Result[int](answer, 0); got != 0 {
		t.Errorf("another type = %d, want 0", got)
	}
	if got := {{.Package}}.Result[string](answer, 0); got != plan {
		t.Errorf("the right type = %q, want %q", got, plan)
	}
}
