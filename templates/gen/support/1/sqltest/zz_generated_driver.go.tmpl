// Package sqltest scripts the statements a SQL adapter runs, so its red
// tests and unit cases reach coverage on new code without a database.
package sqltest

import (
	"context"
	"database/sql"
	"database/sql/driver"
	"fmt"
	"io"
	"reflect"
	"strings"
	"sync"
	"testing"
)

// Step is one scripted statement: the text it contains (empty for any), the
// arguments it must receive (nil for any), the rows or the affected count it
// answers, or the error it fails with.
type Step struct {
	Query    string
	Args     []driver.Value
	Columns  []string
	Rows     [][]driver.Value
	Err      error
	Affected int64
}

// Open answers a database that answers steps in order and reports any other
// statement to tb; it closes at cleanup.
func Open(tb testing.TB, steps ...Step) *sql.DB {
	tb.Helper()
	s := &script{t: tb, steps: steps}
	db := sql.OpenDB(connector{script: s})
	tb.Cleanup(func() { s.report(db.Close()) })
	return db
}

type script struct {
	mu    sync.Mutex
	t     testing.TB
	steps []Step
	next  int
}

// report fails the test with err when there is one.
func (s *script) report(err error) {
	if err != nil {
		s.t.Errorf("sqltest: %v", err)
	}
}

func (s *script) take(query string, args []driver.NamedValue) (Step, error) {
	s.mu.Lock()
	defer s.mu.Unlock()
	if s.next >= len(s.steps) || !strings.Contains(query, s.steps[s.next].Query) {
		err := fmt.Errorf("%w: %q", ErrUnscripted, query)
		s.report(err)
		return Step{}, err
	}
	step := s.steps[s.next]
	s.next++
	if got := values(args); step.Args != nil && !reflect.DeepEqual(got, step.Args) {
		s.t.Errorf("sqltest: %q received %v, want %v", query, got, step.Args)
	}
	return step, step.Err
}

func values(args []driver.NamedValue) []driver.Value {
	out := make([]driver.Value, len(args))
	for i, arg := range args {
		out[i] = arg.Value
	}
	return out
}

type connector struct{ script *script }

func (c connector) Connect(context.Context) (driver.Conn, error) { return &conn{script: c.script}, nil }

func (c connector) Driver() driver.Driver { return scriptDriver(c) }

type scriptDriver struct{ script *script }

func (d scriptDriver) Open(string) (driver.Conn, error) { return &conn{script: d.script}, nil }

type conn struct{ script *script }

// Prepare is refused: an adapter over sqlc runs its statements directly.
func (c *conn) Prepare(query string) (driver.Stmt, error) {
	err := fmt.Errorf("%w: prepare %q", ErrUnscripted, query)
	c.script.report(err)
	return nil, err
}

func (c *conn) Close() error { return nil }

func (c *conn) Begin() (driver.Tx, error) { return tx{}, nil }

func (c *conn) QueryContext(_ context.Context, query string, args []driver.NamedValue) (driver.Rows, error) {
	step, err := c.script.take(query, args)
	if err != nil {
		return nil, err
	}
	return &rows{columns: step.Columns, values: step.Rows}, nil
}

func (c *conn) ExecContext(_ context.Context, query string, args []driver.NamedValue) (driver.Result, error) {
	step, err := c.script.take(query, args)
	if err != nil {
		return nil, err
	}
	return result(step.Affected), nil
}

type tx struct{}

func (tx) Commit() error { return nil }

func (tx) Rollback() error { return nil }

type rows struct {
	columns []string
	values  [][]driver.Value
	next    int
}

func (r *rows) Columns() []string { return r.columns }

func (r *rows) Close() error { return nil }

func (r *rows) Next(dest []driver.Value) error {
	if r.next >= len(r.values) {
		return io.EOF
	}
	copy(dest, r.values[r.next])
	r.next++
	return nil
}

type result int64

func (r result) LastInsertId() (int64, error) { return 0, nil }

func (r result) RowsAffected() (int64, error) { return int64(r), nil }
