package sqltest

import (
	"database/sql"
	"database/sql/driver"
	"errors"
	"fmt"
	"sync"
	"testing"
	"time"
)

// fakeT keeps what a script reports instead of failing the test.
type fakeT struct {
	testing.TB

	lock  sync.Mutex
	lines []string
}

func (f *fakeT) Errorf(format string, args ...any) {
	f.lock.Lock()
	defer f.lock.Unlock()
	f.lines = append(f.lines, fmt.Sprintf(format, args...))
}

func (f *fakeT) reports() int {
	f.lock.Lock()
	defer f.lock.Unlock()
	return len(f.lines)
}

var since = time.Date(2026, time.October, 29, 12, 0, 0, 0, time.UTC)

func TestOpenAnswersTheScriptedRows(t *testing.T) {
	t.Parallel()
	db := Open(t, Step{
		Query: "-- name: ReadPlan ", Args: []driver.Value{"a"},
		Columns: []string{"name", "since"}, Rows: [][]driver.Value{{"{{"}}"basic", since}},
	})
	var name string
	var at time.Time
	err := db.QueryRowContext(t.Context(), "-- name: ReadPlan :one\nSELECT name, since FROM plans WHERE account = $1", "a").Scan(&name, &at)
	if err != nil || name != "basic" || !at.Equal(since) {
		t.Errorf("row = %q %v, %v", name, at, err)
	}
}

func TestOpenAnswersTheScriptedCount(t *testing.T) {
	t.Parallel()
	db := Open(t, Step{Affected: 2})
	res, err := db.ExecContext(t.Context(), "-- name: ArchivePlan :execrows\nUPDATE plans SET archived = TRUE")
	if err != nil {
		t.Fatal(err)
	}
	affected, err := res.RowsAffected()
	if err != nil || affected != 2 {
		t.Errorf("affected = %d, %v", affected, err)
	}
	if id, err := res.LastInsertId(); id != 0 || err != nil {
		t.Errorf("last insert id = %d, %v", id, err)
	}
}

func TestOpenAnswersTheScriptedError(t *testing.T) {
	t.Parallel()
	db := Open(t, Step{Err: sql.ErrNoRows}, Step{Err: sql.ErrConnDone})
	var name string
	if err := db.QueryRowContext(t.Context(), "SELECT name FROM plans").Scan(&name); !errors.Is(err, sql.ErrNoRows) {
		t.Errorf("query error = %v", err)
	}
	if _, err := db.ExecContext(t.Context(), "UPDATE plans SET archived = TRUE"); !errors.Is(err, sql.ErrConnDone) {
		t.Errorf("exec error = %v", err)
	}
}

func TestOpenReportsWhatTheTestDidNotScript(t *testing.T) {
	t.Parallel()
	tests := []struct {
		name string
		run  func(t *testing.T, db *sql.DB) error
	}{
		{"a query past the script", func(t *testing.T, db *sql.DB) error {
			t.Helper()
			return fmt.Errorf("query: %w", db.QueryRowContext(t.Context(), "SELECT 1").Err())
		}},
		{"another statement", func(t *testing.T, db *sql.DB) error {
			t.Helper()
			_, err := db.ExecContext(t.Context(), "DELETE FROM plans")
			return fmt.Errorf("exec: %w", err)
		}},
		{"a prepared statement", func(t *testing.T, db *sql.DB) error {
			t.Helper()
			stmt, err := db.PrepareContext(t.Context(), "SELECT 1")
			if err != nil {
				return fmt.Errorf("prepare: %w", err)
			}
			defer func() {
				if err := stmt.Close(); err != nil {
					t.Errorf("close = %v", err)
				}
			}()
			return nil
		}},
	}
	for _, tc := range tests {
		t.Run(tc.name, func(t *testing.T) {
			t.Parallel()
			fake := &fakeT{TB: t}
			db := Open(fake, Step{Query: "-- name: ReadPlan "})
			if err := tc.run(t, db); !errors.Is(err, ErrUnscripted) || fake.reports() == 0 {
				t.Errorf("error = %v with %d reports", err, fake.reports())
			}
		})
	}
}

func TestOpenReportsArgumentsThatDiffer(t *testing.T) {
	t.Parallel()
	fake := &fakeT{TB: t}
	db := Open(fake, Step{Args: []driver.Value{"a"}, Affected: 1})
	if _, err := db.ExecContext(t.Context(), "UPDATE plans SET archived = TRUE WHERE account = $1", "b"); err != nil {
		t.Fatal(err)
	}
	if fake.reports() != 1 {
		t.Errorf("reports = %d, want 1", fake.reports())
	}
}

func TestOpenRunsTransactionsAndTheDriver(t *testing.T) {
	t.Parallel()
	db := Open(t)
	tx, err := db.BeginTx(t.Context(), nil)
	if err != nil {
		t.Fatal(err)
	}
	if err = tx.Commit(); err != nil {
		t.Errorf("commit = %v", err)
	}
	again, err := db.BeginTx(t.Context(), nil)
	if err != nil {
		t.Fatal(err)
	}
	if err = again.Rollback(); err != nil {
		t.Errorf("rollback = %v", err)
	}
	c, err := db.Driver().Open("")
	if c == nil || err != nil {
		t.Errorf("driver open = %v, %v", c, err)
	}
}

func TestRowsEndAfterTheScript(t *testing.T) {
	t.Parallel()
	db := Open(t, Step{Columns: []string{"name"}})
	rows, err := db.QueryContext(t.Context(), "SELECT name FROM plans")
	if err != nil {
		t.Fatal(err)
	}
	defer func() {
		if err := rows.Close(); err != nil {
			t.Errorf("close = %v", err)
		}
	}()
	if rows.Next() {
		t.Error("rows answered a row the step did not script")
	}
	if err := rows.Err(); err != nil {
		t.Errorf("rows error = %v", err)
	}
}
