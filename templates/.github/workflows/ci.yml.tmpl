{{define "job"}}
    if: github.event_name == 'pull_request' || github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    runs-on: ubuntu-latest
    timeout-minutes: 30
    env: {GOFLAGS: "-mod=readonly"}
    defaults: {run: {shell: bash} }
    steps:
      - uses: actions/checkout@08c6903cd8c0fde910a37f88322edcfb5dd907a8 # v5.0.0
        with: {fetch-depth: 0, persist-credentials: false}
      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
{{- if has .Capabilities "go"}}
        with: {go-version-file: go.mod}
{{- else}}
        with: {go-version: "1.27.0", cache: false}
{{- end}}
      - run: echo "GOTOOLCHAIN=auto" >> "$GITHUB_ENV"
      - run: go install github.com/cristianargotti/golaw/cmd/golaw@v{{.KitVersion}}
{{- if has .Capabilities "go"}}
      - run: |
          go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v{{index .Tools "golangci-lint"}}
          go install -ldflags=-X=github.com/zricethezav/gitleaks/v8/version.Version=v{{.Tools.gitleaks}} github.com/zricethezav/gitleaks/v8@v{{.Tools.gitleaks}}
          go install golang.org/x/vuln/cmd/govulncheck@v{{.Tools.govulncheck}}
{{- end}}
{{- if or (has .Capabilities "api") (has .Capabilities "db")}}
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with: {node-version: "22.19.0", package-manager-cache: false}
{{- end}}
{{- if has .Capabilities "api"}}
      - run: npm install --global @redocly/cli@2.5.0
{{- end}}
{{- if has .Capabilities "db"}}
      - run: npm install --global squawk-cli@2.35.0
{{- end}}
{{- if has .Capabilities "image"}}
      - run: |
          mkdir -p "$RUNNER_TEMP/golaw-bin"
          echo "$RUNNER_TEMP/golaw-bin" >> "$GITHUB_PATH"
          curl -fsSL https://github.com/hadolint/hadolint/releases/download/v2.15.1/hadolint-linux-x86_64 -o "$RUNNER_TEMP/hadolint"
          printf '%s  %s\n' 'c7187db94eeeeca956519a6af171adc31453941a1e777961f6e680f697c8c507' "$RUNNER_TEMP/hadolint" | sha256sum -c -
          install -m 0755 "$RUNNER_TEMP/hadolint" "$RUNNER_TEMP/golaw-bin/hadolint"
          curl -fsSL https://github.com/aquasecurity/trivy/releases/download/v0.75.0/trivy_0.75.0_Linux-64bit.tar.gz -o "$RUNNER_TEMP/trivy.tar.gz"
          printf '%s  %s\n' 'c6e65abddb348e25f10549df887045629cf28cc72453cd1c63acb717316b3f3f' "$RUNNER_TEMP/trivy.tar.gz" | sha256sum -c -
          tar -xzf "$RUNNER_TEMP/trivy.tar.gz" -C "$RUNNER_TEMP/golaw-bin" trivy
          docker version
{{- end}}
{{- end}}
{{define "surface-tools"}}
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with: {node-version: "22.19.0", package-manager-cache: false}
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with: {python-version: "3.12"}
      - uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ~/.local/share/golaw/tools
          key: golaw-tools-{{printf "%s" "${{ runner.os }}"}}-v{{.KitVersion}}
      - run: golaw setup --surface
{{- end}}
name: CI
on: [push, pull_request]
permissions: {contents: read}
jobs:
  ci:
{{- template "job" .}}
{{- template "surface-tools" .}}
      - run: make ci
        env:
          GOLAW_ENROLLED: {{printf "%s" "${{ vars.GOLAW_ENROLLED }}"}}
      - run: git diff --exit-code
  surface:
{{- template "job" .}}
{{- template "surface-tools" .}}
      - run: make lint-surface{{if has .Capabilities "go"}} coverage-new{{end}}
      - run: git diff --exit-code
{{- if has .Capabilities "api"}}
  api:
{{- template "job" .}}
      - run: make openapi-breaking openapi-examples-check docs-check
      - run: git diff --exit-code
{{- end}}
{{- if has .Capabilities "db"}}
  db:
{{- template "job" .}}
      - run: make migrate-lint
      - run: git diff --exit-code
{{- end}}
{{- if has .Capabilities "image"}}
  image:
{{- template "job" .}}
{{- template "surface-tools" .}}
      - run: make dockerfile-lint image-pins-check image image-scan
      - run: git diff --exit-code
{{- end}}
{{- if has .Capabilities "hexagonal"}}
  hexagonal:
{{- template "job" .}}
      - run: make lint
      - run: git diff --exit-code
{{- end}}
