package secret_test

import (
	"bytes"
	"encoding/json"
	"fmt"
	"log/slog"
	"strings"
	"testing"

	"{{.ModulePath}}/internal/secret"
)

const value = "s3cr3t-value"

func TestSecretRedactsEveryPrintingPath(t *testing.T) {
	t.Parallel()
	held := secret.New(value)
	encoded, err := json.Marshal(struct {
		Key secret.Secret `json:"key"`
	}{held})
	if err != nil {
		t.Fatal(err)
	}
	var logged bytes.Buffer
	slog.New(slog.NewTextHandler(&logged, nil)).Info("sample", slog.Any("key", held))
	for _, printed := range []string{
		held.String(), fmt.Sprintf("%v %s %#v", held, held, held), string(encoded), logged.String(),
	} {
		if strings.Contains(printed, value) || !strings.Contains(printed, "[redacted]") {
			t.Fatalf("printed %q", printed)
		}
	}
	if held.Reveal() != value {
		t.Fatal("Reveal must answer the value")
	}
}
