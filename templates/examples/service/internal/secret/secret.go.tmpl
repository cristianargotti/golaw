// Package secret holds a credential so that no log line, format verb or
// encoder can print it: only Reveal hands the value to the code that sends it.
package secret

import "log/slog"

// redacted is what every printing path shows instead of the value.
const redacted = "[redacted]"

// Secret is a credential value that redacts itself everywhere it is printed.
type Secret struct {
	value string
}

// New wraps a credential value.
func New(value string) Secret {
	return Secret{value: value}
}

// Reveal answers the value, for the one call that sends it.
func (s Secret) Reveal() string {
	return s.value
}

// String redacts the value for fmt and the %s and %v verbs.
func (s Secret) String() string {
	return redacted
}

// GoString redacts the value for the %#v verb.
func (s Secret) GoString() string {
	return redacted
}

// MarshalText redacts the value for encoding/json and every text encoder.
func (s Secret) MarshalText() ([]byte, error) {
	return []byte(redacted), nil
}

// LogValue redacts the value for log/slog.
func (s Secret) LogValue() slog.Value {
	return slog.StringValue(redacted)
}
